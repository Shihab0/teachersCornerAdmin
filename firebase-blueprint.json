{
  "entities": {
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher profile data",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 20 },
        "collegeName": { "type": "string" },
        "presentAddress": { "type": "string" },
        "permanentAddress": { "type": "string" },
        "canTeachHSC": { "type": "boolean" },
        "isMedical": { "type": "boolean" },
        "rating": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "phone", "status"]
    },
    "TeacherAuth": {
      "title": "TeacherAuth",
      "description": "Teacher OTP verification, daily rate limit, and OTP-free dashboard login PIN state",
      "type": "object",
      "properties": {
        "phone": { "type": "string", "maxLength": 20 },
        "otpHash": { "type": "string" },
        "expiresAt": { "type": "number" },
        "attempts": { "type": "number" },
        "dailyCount": { "type": "number" },
        "dailyResetDate": { "type": "string" },
        "lastSentAt": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "pinHash": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["phone"]
    },
    "Deal": {
      "title": "Deal",
      "description": "Tuition deal data",
      "type": "object",
      "properties": {
        "tuitionId": { "type": "string" },
        "tutorName": { "type": "string" },
        "tutorPhone": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "studentClass": { "type": "string" },
        "details": { "type": "string" },
        "referrerName": { "type": "string" },
        "adminName": { "type": "string" },
        "selectionDate": { "type": "string" },
        "confirmDate": { "type": "string" },
        "commission": { "type": "number" },
        "tuitionStatus": { "type": "string" },
        "commissionStatus": { "type": "string" },
        "collectedBy": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "history": { "type": "array" }
      }
    },
    "Expense": {
      "title": "Expense",
      "description": "Office expense data",
      "type": "object",
      "properties": {
        "adminName": { "type": "string" },
        "amount": { "type": "number" },
        "purpose": { "type": "string" },
        "createdAt": { "type": "number" },
        "history": { "type": "array" }
      }
    }
  },
  "firestore": {
    "/artifacts/{appId}/public/data/tc_teachers/{docId}": {
      "schema": "Teacher",
      "description": "Collection of teachers"
    },
    "/artifacts/{appId}/public/data/tc_teacher_auth/{phone}": {
      "schema": "TeacherAuth",
      "description": "Collection storing teacher OTP rate limits and OTP-free repeat dashboard login credentials"
    },
    "/artifacts/{appId}/public/data/tc_deals/{docId}": {
      "schema": "Deal",
      "description": "Collection of tuition deals"
    },
    "/artifacts/{appId}/public/data/tc_expenses/{docId}": {
      "schema": "Expense",
      "description": "Collection of office expenses"
    }
  }
}
